# Rendered output and editor/scratch leftovers - never committed.
*.html
*_files/
/_freeze/
.Rhistory
.DS_Store

# Stray scratch scripts stay out, but the precompile driver must be tracked.
*.R
!build.R

# NOTE: the knitted *.Rmd files and their figure folders (e.g. fit-to-fia/) are
# generated by build.R but ARE committed on purpose - they are what ships to
# CRAN. Do not add them here.

/.quarto/
**/*.quarto_ipynb

# Prediction dump written by E-Mortality (regenerated on every knit).
E-mortality-predictions.csv
